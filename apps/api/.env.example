# Copy to .env and adjust. Every variable is validated at startup (src/config.ts).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Origin serving web app, /api and /ws (same origin). https is mandatory in production.
PUBLIC_ORIGIN=http://localhost:3000
# Extra origins allowed for CORS/CSRF checks (verified white-label hosts), comma separated.
# The Vite dev server (http://localhost:5173) must be listed while the web app runs on its own port.
TRUSTED_ORIGINS=http://localhost:5173
# true only behind a reverse proxy you control (Caddy).
TRUST_PROXY=false

# Role domusafe_app only (never the owner or a superuser). Password set by `domusafe-db migrate`
# through DOMUSAFE_APP_DB_PASSWORD.
DATABASE_URL=postgres://domusafe_app:change-me@localhost:5432/domusafe
DATABASE_POOL_SIZE=10

# Required in production: shared rate limits, idempotency records and session cache.
VALKEY_URL=redis://localhost:6379

# Class S master keys: comma-separated version:base64url(32 bytes). Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOMUSAFE_MASTER_KEYS=1:replace-with-32-random-bytes-in-base64url
DOMUSAFE_MASTER_KEY_ACTIVE=1
