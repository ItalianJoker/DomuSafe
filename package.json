{
  "name": "domusafe-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:roles": "pnpm --filter @domusafe/db run roles",
    "db:migrate": "pnpm --filter @domusafe/db run migrate",
    "openapi:write": "pnpm --filter @domusafe/api run openapi:write",
    "openapi:check": "pnpm --filter @domusafe/api run openapi:check",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run openapi:check && pnpm --filter @domusafe/web api:check"
  },
  "devDependencies": {
    "@domusafe/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "tsx": "4.23.15"
  }
}
