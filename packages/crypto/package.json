{
  "name": "@domusafe/crypto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client-side and server-side cryptography for DomuSafe: envelope formats, key hierarchy, PIN and recovery.",
  "exports": {
    ".": {
      "@domusafe/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@scure/bip39": "2.4.0",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@domusafe/config": "workspace:*"
  }
}
