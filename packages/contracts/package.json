{
  "name": "@domusafe/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Zod schemas shared by API and web: conventions, problem details, permissions, resource contracts.",
  "exports": {
    ".": {
      "@domusafe/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@domusafe/plans": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@domusafe/config": "workspace:*"
  }
}
